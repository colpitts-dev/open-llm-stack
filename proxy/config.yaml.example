# proxy/config.yaml.example -- copy to proxy/config.yaml (gitignored; `make init` does this) and edit
# to match the models YOUR backend actually serves. This sample registers the tags present on the
# project's reference host (Ollama). THE REGISTRY IS HAND-MAINTAINED: nothing discovers models.
#
# The context contract (plan 14), the same for every backend:
#   context_window     physical window PER SLOT the backend is configured for (model_info; a declaration, verified by make context-probe)
#   max_output_tokens  output budget (32768 for reasoning models: thinking counts)
#   max_input_tokens = context_window - max_output_tokens - margin,   margin = max(context_window / 4, 8192)
# The 25% margin covers the agents' token estimate (measured 23% under the real count) plus template/tool scaffolding.
# The backend must honour context_window: Ollama entries mirror it as litellm_params.num_ctx (forwarded per request) and
# carry keep_alive ("5m": idle GPU between jobs); llama.cpp is -c <window x slots> -np <slots>; vLLM --max-model-len.
# Ollama: `make model-fit M=<tag>` measures the window on the live backend and prints this block. Any backend:
# `make context-probe` proves the declaration through the gateway; `make context-report` shows real use against the caps.
#
# Prefixes: ollama_chat/<tag> for Ollama chat models (applies the model's chat template; plain
# ollama/ degrades tool calling); ollama/<tag> for Ollama embeddings; openai/<name> + api_base for
# llama.cpp / vLLM / any OpenAI-compatible server. Never register a closed-weight model or a router.
# Adding a model = edit this file + `make reload`.

model_list:
  - model_name: qwen3.8-q5
    litellm_params:
      model: ollama_chat/smtek/Qwen3.8-27B:Q5_K_XL-96k
      api_base: os.environ/LLM_BASE_URL
      num_ctx: 131072                 # = context_window; make model-fit 2026-09-15: 20141 MiB on the GPU
      keep_alive: "5m"
    model_info:
      mode: chat
      context_window: 131072
      max_input_tokens: 65536         # 131072 - 32768 - 32768
      max_output_tokens: 32768
      supports_function_calling: true # native tool calls, not LiteLLM JSON-mode fallback
      supports_vision: true
      model_revision: "ollama:smtek/Qwen3.8-27B:Q5_K_XL-96k:2026-09-15"
      execution_locus: local

  - model_name: qwen3.6-max
    litellm_params:
      model: ollama_chat/qwen3.6-max
      api_base: os.environ/LLM_BASE_URL
      num_ctx: 131072                 # = context_window; make model-fit 2026-09-14: 21288 MiB on the GPU (one slot: qwen3.5-family models get no parallel slots on Ollama 0.33.3)
      keep_alive: "5m"
    model_info:
      mode: chat
      context_window: 131072          # per slot; sized to real use (p95 prompt 93k + 32k output), not the tag's 262144 maximum
      max_input_tokens: 65536         # 131072 - 32768 - 32768
      max_output_tokens: 32768
      supports_vision: true
      model_revision: "ollama:qwen3.6-max:2026-09-14"
      execution_locus: local

  - model_name: ornith-max
    litellm_params:
      model: ollama_chat/ornith-max
      api_base: os.environ/LLM_BASE_URL
      num_ctx: 131072                 # = context_window; make model-fit 2026-09-14: 22010 MiB on the GPU (one slot: qwen3.5-family models get no parallel slots on Ollama 0.33.3)
      keep_alive: "5m"
    model_info:
      mode: chat
      context_window: 131072          # per slot; sized to real use (p95 prompt 93k + 32k output), not the tag's 262144 maximum
      max_input_tokens: 65536         # 131072 - 32768 - 32768
      max_output_tokens: 32768
      model_revision: "ollama:ornith-max:2026-09-14"
      execution_locus: local

  - model_name: laguna-max
    litellm_params:
      model: ollama_chat/laguna-max
      api_base: os.environ/LLM_BASE_URL
      num_ctx: 131072                 # = context_window; make model-fit 2026-09-14: 21114 MiB on the GPU (one slot: qwen3.5-family models get no parallel slots on Ollama 0.33.3)
      keep_alive: "5m"
    model_info:
      mode: chat
      context_window: 131072          # per slot; sized to real use (p95 prompt 93k + 32k output), not the tag's 262144 maximum
      max_input_tokens: 65536         # 131072 - 32768 - 32768
      max_output_tokens: 32768
      model_revision: "ollama:laguna-max:2026-09-14"
      execution_locus: local

  - model_name: qwen3.8-max
    litellm_params:
      model: ollama_chat/qwen3.8-max
      api_base: os.environ/LLM_BASE_URL
      num_ctx: 131072                 # = context_window; make model-fit 2026-09-14: 17043 MiB on the GPU (one slot: qwen3.5-family models get no parallel slots on Ollama 0.33.3)
      keep_alive: "5m"
    model_info:
      mode: chat
      context_window: 131072          # per slot; sized to real use (p95 prompt 93k + 32k output), not the tag's 262144 maximum
      max_input_tokens: 65536         # 131072 - 32768 - 32768
      max_output_tokens: 32768
      model_revision: "ollama:qwen3.8-max:2026-09-14"
      execution_locus: local

  - model_name: glm-4.7-flash
    litellm_params:
      model: ollama_chat/glm-4.7-flash:latest
      api_base: os.environ/LLM_BASE_URL
      num_ctx: 131072                 # = context_window; make model-fit 2026-09-15: 29392 MiB on the GPU (5 MiB under budget; 2048 MiB headroom already reserved)
      keep_alive: "5m"
    model_info:
      mode: chat
      context_window: 131072
      max_input_tokens: 65536         # 131072 - 32768 - 32768
      max_output_tokens: 32768        # thinking model: reasoning counts
      supports_function_calling: true
      model_revision: "ollama:glm-4.7-flash:2026-09-15"
      execution_locus: local

  - model_name: devstral-small-2
    litellm_params:
      model: ollama_chat/devstral-small-2:latest
      api_base: os.environ/LLM_BASE_URL
      num_ctx: 49152                  # = context_window; make model-fit 2026-09-15: 26264 MiB on the GPU (65536 spills to CPU: dense 40-layer KV)
      keep_alive: "5m"
    model_info:
      mode: chat
      context_window: 49152
      max_input_tokens: 28672         # 49152 - 8192 - 12288
      max_output_tokens: 8192         # non-thinking model: 32768 would leave 4096 input
      supports_function_calling: true
      supports_vision: true
      model_revision: "ollama:devstral-small-2:2026-09-15"
      execution_locus: local

  - model_name: embed
    litellm_params:
      model: ollama/embed               # plain ollama/ is correct for embeddings
      api_base: os.environ/LLM_BASE_URL
    model_info:
      mode: embedding
      model_revision: "ollama:embed:2026-09-12"
      execution_locus: local

  # Also present on the reference host -- uncomment to register (same window formula applies):
  # ornith-1.5:35b, laguna-xs-2.1, qwen3.8:27b, qwen3.6:35b (chat), qwen3-embedding:0.6b (embedding)

  # --- llama.cpp / vLLM / LM Studio (OpenAI-compatible) example: the window is a SERVER flag, declared here and probed ---
  # - model_name: my-gguf-model
  #   litellm_params:
  #     model: openai/my-gguf-model
  #     api_base: http://llamacpp:8080/v1     # bundled profile; or http://host.docker.internal:8080/v1
  #     api_key: sk-unused                     # the client requires *a* key; an unauthenticated server ignores it.
  #                                            # Server with auth: api_key: os.environ/LLM_API_KEY (set LLM_API_KEY in .env)
  #   model_info:
  #     mode: chat
  #     context_window: 32768                 # llama.cpp: -c 98304 -np 3 gives 32768 per slot (LLAMACPP_CTX_SIZE = window x slots)
  #     max_input_tokens: 20480               # 32768 - 4096 - 8192
  #     max_output_tokens: 4096
  #     execution_locus: local

litellm_settings:
  drop_params: true      # unsupported client params are dropped, not errored -- backends vary
  num_retries: 0         # a retry produces a second generation attributed to the first
  request_timeout: 900   # long prefills on large local contexts

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
